          "stasiun_tujuan": {
            "type": "string",
            "enum": [
              "AK", "BJD", "BKS", "BKST", "BOO", "CBI", "CIT", "CJT", "CKI", "CKR",
              "CTA", "CUK", "DAR", "DP", "DPB", "DU", "GDD", "GST", "JAKK", "JNG",
              "JUA", "KBY", "KDB", "KLD", "KMO", "KPB", "KRI", "LNA", "MJ", "MRI",
              "NMO", "PDJ", "PGB", "POC", "PRP", "PSE", "PSM", "RKS", "RW", "SDB",
              "SDM", "SRP", "SUD", "TB", "TEB", "THB", "TNG", "TPK", "UI", "UP"
            ],
            "description": "Kode stasiun KRL tujuan"
          },
          "waktu": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+07:00$",
