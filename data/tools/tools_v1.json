[
  {
    "type": "function",
    "function": {
      "name": "buat_pengingat",
      "description": "Membuat pengingat jadwal pada waktu tertentu.",
      "parameters": {
        "type": "object",
        "properties": {
          "judul": {
            "type": "string",
            "minLength": 1,
            "description": "Judul atau isi singkat pengingat"
          },
          "waktu": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+07:00$",
            "description": "Waktu pengingat dalam format ISO-8601 WIB (+07:00), yaitu YYYY-MM-DDTHH:MM:SS+07:00"
          }
        },
        "required": ["judul", "waktu"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "transfer_ewallet",
      "description": "Mengirim uang lewat dompet digital.",
      "parameters": {
        "type": "object",
        "properties": {
          "penerima": {
            "type": "string",
            "minLength": 1,
            "description": "Nama atau nomor penerima"
          },
