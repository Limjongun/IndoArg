            "type": "integer",
            "minimum": 1000,
            "description": "Jumlah dalam rupiah, bilangan bulat tanpa titik"
          },
          "platform": {
            "type": "string",
            "enum": ["gopay", "ovo", "dana", "shopeepay"],
            "description": "Nama layanan dompet digital kanonik"
          }
        },
        "required": ["penerima", "nominal", "platform"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cek_ongkir",
      "description": "Mengecek estimasi ongkos kirim paket antarwilayah di Indonesia.",
      "parameters": {
        "type": "object",
        "properties": {
          "asal": {
            "type": "string",
            "pattern": "^[0-9]{2}\\.[0-9]{2}$",
            "description": "Kode wilayah asal resmi Kemendagri (format XX.XX)"
          },
          "tujuan": {
            "type": "string",
            "pattern": "^[0-9]{2}\\.[0-9]{2}$",
            "description": "Kode wilayah tujuan resmi Kemendagri (format XX.XX)"
          },
          "berat_gram": {
            "type": "integer",
            "minimum": 1,
            "description": "Berat paket dalam satuan gram (bilangan bulat)"
          },
          "kurir": {
            "type": "string",
            "enum": ["jne", "jnt", "sicepat", "pos"],
            "description": "Kode kurir ekspedisi"
          }
        },
        "required": ["asal", "tujuan", "berat_gram", "kurir"],
        "additionalProperties": false
      }
    }
  },
  {
