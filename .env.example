# Salin file ini menjadi .env lalu isi sesuai kebutuhan lokal.
# JANGAN commit file .env ke Git.

# Hugging Face token (opsional; diperlukan bila mengunduh repo gated)
HF_TOKEN=

# Endpoint runtime lokal
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
OLLAMA_HOST=http://127.0.0.1:11434

# Lokasi biner llama.cpp (ubah bila memakai instalasi lokal di tools/llama.cpp/)
LLAMA_SERVER_BIN=llama-server
LLAMA_QUANTIZE_BIN=llama-quantize
LLAMA_IMATRIX_BIN=llama-imatrix

# Direktori penyimpanan model GGUF & cache Hugging Face (di disk D agar tidak memenuhi disk C)
INDOARG_MODEL_DIR=D:\Indoarg\models
HF_HOME=D:\Indoarg\models\_hf_cache
HF_HUB_CACHE=D:\Indoarg\models\_hf_cache\hub
HF_XET_CACHE=D:\Indoarg\models\_hf_cache\xet
HF_ASSETS_CACHE=D:\Indoarg\models\_hf_cache\assets
OLLAMA_MODELS=D:\ollama\models
