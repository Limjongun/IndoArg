# Eksperimen C: Ollama memakai file GGUF lokal yang IDENTIK dengan llama.cpp (sha256 sama).
# Jalankan dari root workspace:
#   ollama create indoarg-m1-q4km -f models/modelfiles/M1.Modelfile
FROM ../Q4_K_M/M1.gguf
PARAMETER temperature 0
PARAMETER top_p 1.0
PARAMETER top_k 0
PARAMETER repeat_penalty 1.0
PARAMETER num_ctx 8192
