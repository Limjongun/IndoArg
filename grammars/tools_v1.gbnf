# Primitives & canonical Indonesian formats
ws ::= [ \t\n\r]*
digit ::= [0-9]
upper ::= [A-Z]
integer ::= "-"? ("0" | [1-9] digit*)
number ::= "-"? ("0" | [1-9] digit*) ("." digit+)?
boolean ::= "true" | "false"
iso-date ::= "\"" digit digit digit digit "-" digit digit "-" digit digit "\""
iso-datetime-wib ::= "\"" digit digit digit digit "-" digit digit "-" digit digit "T" digit digit ":" digit digit ":" digit digit "+07:00\""
kode-wilayah ::= "\"" digit digit "." digit digit "\""
iso-currency ::= "\"" upper upper upper "\""
string ::= "\"" char* "\""
char ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
string-array ::= "[" ws string (ws "," ws string)* ws "]"
json-array ::= "[" ws (string | number) (ws "," ws (string | number))* ws "]"
